# Supply raw JSON or base64-encoded Firebase service-account JSON.
# Add both values to Vercel for the atleta-v1 Auth and atleta-v2 Firestore projects.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_V2=

# Backward-compatible aliases accepted by the backend.
# FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY_V2=
