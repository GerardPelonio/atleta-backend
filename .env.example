# Server Configuration
PORT=5000

# Authentication & Security
# CRITICAL: Missing JWT_SECRET will cause server startup to fail immediately
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin SDK Configuration
# Option 1: Inline service account credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option 2: Full JSON string (or base64 encoded)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option 3: Local file 'serviceAccountKey.json' in Backend directory

# Firebase Web Client Configuration (Optional REST fallback)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIRESTORE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# AI & OCR Services
# CRITICAL: Required for scoresheet scanning and OCR processing
GEMINI_API_KEY=

# Email / Password Reset Service
EMAIL_USER=
EMAIL_PASS=
FRONTEND_RESET_URL=

# OAuth Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
FACEBOOK_APP_ID=
